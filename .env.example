# Copie este arquivo para .env e substitua os valores antes de iniciar.
PORT=3000
NODE_ENV=development
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
BROKER_EMAIL=corretor@exemplo.com
BROKER_PASSWORD=SUBSTITUA_POR_UMA_SENHA_DE_PELO_MENOS_12_CARACTERES
# Localmente, pode deixar o padrão. No Render: /var/data
DATA_DIR=./storage
# Opcional: origem exata do Wix para permitir leitura da API pública pelo navegador.
# Exemplo: https://www.suaimobiliaria.com.br (sem barra final)
WIX_ORIGIN=
